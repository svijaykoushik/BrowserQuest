FROM nginx:alpine

# Copy custom Nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy client static assets
COPY client/ /usr/share/nginx/html/

# Copy shared library definitions required by client RequireJS (gametypes.js)
COPY shared/ /usr/share/nginx/html/shared/

# Copy client configuration for stack
COPY client/config/config_stack.json /usr/share/nginx/html/config/config_build.json
COPY client/config/config_stack.json /usr/share/nginx/html/config/config_local.json

# Ensure correct permissions for Nginx web server
RUN chmod -R 755 /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
